{
  "info": {
    "_postman_id": "4307530d-a79b-4cd9-a1bb-07bfc795b9db",
    "name": "Vavito Archives API - Fluxo demonstrável",
    "description": "Coleção segura para demonstrar a API local. Execute as pastas em ordem. O login usa a API pública do Supabase e salva somente o access token na memória da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Sistema",
      "item": [
        {
          "name": "Informações da API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1",
            "description": "Confirma nome e versão da API."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('API disponível', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health",
            "description": "Confirma que o processo da API está vivo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Processo saudável', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/health/ready",
            "description": "Confirma que a API consegue consultar o PostgreSQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('API pronta', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticação",
      "item": [
        {
          "name": "Entrar pelo Supabase",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabasePublishableKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
            "description": "Obtém um JWT do Supabase e salva accessToken como variável da coleção. Use um usuário confirmado cujo Profile possua role ADMIN para executar o fluxo editorial."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login concluído', () => pm.response.to.have.status(200));",
                  "const response = pm.response.json();",
                  "pm.expect(response.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', response.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar meu perfil",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/profiles/me",
            "description": "Valida o JWT capturado e confirma o Profile associado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Perfil autenticado', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Conteúdo público",
      "item": [
        {
          "name": "Listar tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/tags"
          }
        },
        {
          "name": "Listar artigos publicados",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/posts?page=1&limit=20"
          }
        },
        {
          "name": "Buscar artigos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/posts/search?q=arquitetura&page=1&limit=20"
          }
        },
        {
          "name": "Consultar artigo criado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/posts/{{postSlug}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Artigo publicado disponível', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Registrar visualização",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/posts/{{postSlug}}/views",
            "description": "Registra uma visualização deduplicada pelo fingerprint diário."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Visualização aceita', () => pm.response.to.have.status(202));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Fluxo editorial",
      "item": [
        {
          "name": "Criar rascunho",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Artigo demonstrável do Vavito\",\n  \"slug\": \"artigo-demonstravel-vavito\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/admin/posts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rascunho criado', () => pm.response.to.have.status(201));",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('postId', response.id);",
                  "pm.collectionVariables.set('postSlug', response.slug);"
                ]
              }
            }
          ]
        },
        {
          "name": "Completar conteúdo do rascunho",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"excerpt\": \"Fluxo demonstrável da API do Vavito Archives.\",\n  \"content\": {\n    \"type\": \"doc\",\n    \"content\": [\n      {\n        \"type\": \"paragraph\",\n        \"content\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"Este artigo foi criado pela coleção Postman.\"\n          }\n        ]\n      }\n    ]\n  },\n  \"contentSchemaVersion\": 1,\n  \"tagNames\": [\"Demonstração\", \"API\"],\n  \"seoTitle\": \"Demonstração da API Vavito\",\n  \"seoDescription\": \"Fluxo editorial executado pela coleção Postman.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/admin/posts/{{postId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Conteúdo atualizado', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Publicar artigo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/posts/{{postId}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Artigo publicado', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Consultar revisões",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/posts/{{postId}}/revisions"
          }
        }
      ]
    },
    {
      "name": "04 - Engajamento autenticado",
      "item": [
        {
          "name": "Comentar no artigo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Comentário criado pelo fluxo demonstrável.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/posts/{{postSlug}}/comments"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Comentário criado', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('commentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Curtir artigo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"LIKE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/posts/{{postId}}/reaction"
          }
        },
        {
          "name": "Salvar bookmark",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": "{{baseUrl}}/api/v1/posts/{{postId}}/bookmark"
          }
        },
        {
          "name": "Listar bookmarks",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookmarks?page=1&limit=20"
          }
        }
      ]
    },
    {
      "name": "05 - Comunicação",
      "item": [
        {
          "name": "Enviar contato",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pessoa Avaliadora\",\n  \"email\": \"avaliador@example.com\",\n  \"subject\": \"Demonstração da API\",\n  \"message\": \"Mensagem enviada pela coleção Postman do Vavito Archives.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/contact",
            "description": "Persiste a mensagem e tenta notificar o administrador pelo Resend."
          }
        },
        {
          "name": "Solicitar inscrição na newsletter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newsletterEmail}}\",\n  \"consent\": true,\n  \"source\": \"ARTICLE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/newsletter/subscriptions",
            "description": "Inicia o double opt-in. A confirmação depende do email entregue pelo Resend."
          }
        }
      ]
    },
    {
      "name": "06 - Campanha opcional",
      "description": "Requer pelo menos um assinante confirmado e a integração do Resend configurada.",
      "item": [
        {
          "name": "Criar campanha do artigo",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"postId\": \"{{postId}}\",\n  \"subject\": \"Novo artigo demonstrável\",\n  \"previewText\": \"Conheça o fluxo completo do Vavito Archives.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/admin/newsletter/campaigns"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Campanha criada', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('campaignId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Enviar campanha uma única vez",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/v1/admin/newsletter/campaigns/{{campaignId}}/send"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('idempotencyKey')) {",
                  "  pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "supabaseUrl",
      "value": "http://127.0.0.1:54321",
      "type": "string"
    },
    {
      "key": "supabasePublishableKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "postSlug",
      "value": "",
      "type": "string"
    },
    {
      "key": "commentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "campaignId",
      "value": "",
      "type": "string"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "newsletterEmail",
      "value": "leitor@example.com",
      "type": "string"
    }
  ]
}
