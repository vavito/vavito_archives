{
  "name": "@vavito/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "joi": "18.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "@vavito/eslint-config": "workspace:*",
    "@vavito/typescript-config": "workspace:*",
    "eslint": "9.39.5",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsc-alias": "1.9.1",
    "typescript": "5.9.3"
  }
}
