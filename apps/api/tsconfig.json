{
  "extends": "@vavito/typescript-config/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "esModuleInterop": true,
    "paths": {
      "@api/*": ["src/*"]
    },
    "incremental": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
