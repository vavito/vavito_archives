{
  "extends": "@vavito/typescript-config/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "esModuleInterop": true,
    "paths": {
      "@api/*": ["./src/*"]
    },
    "incremental": true
  },
  "include": ["prisma.config.ts", "prisma/**/*.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
