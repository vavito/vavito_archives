{
  "extends": "@vavito/typescript-config/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "esModuleInterop": true,
    "isolatedModules": true,
    "paths": {
      "@api/*": ["./src/*"]
    },
    "incremental": true,
    "types": ["jest", "multer", "node"]
  },
  "include": ["prisma.config.ts", "prisma/**/*.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
