# Aplicação
NODE_ENV=development
PORT=3001
APP_VERSION=0.0.0
SWAGGER_ENABLED=true
FRONTEND_URL=http://localhost:3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vavito_archives
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vavito_archives
DATABASE_CONNECT_ON_START=true

# Seed administrativo: use o UUID de um usuário já criado no Supabase Auth
ADMIN_USER_ID=replace_with_existing_supabase_auth_user_uuid
ADMIN_DISPLAY_NAME=Administrador

# Supabase — somente servidor
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace_with_local_service_role_key
SUPABASE_AVATARS_BUCKET=avatars
SUPABASE_MEDIA_BUCKET=media

# Resend — somente servidor
RESEND_API_KEY=re_replace_with_api_key
RESEND_TIMEOUT_MS=5000
RESEND_MAX_ATTEMPTS=3
MAIL_CONTACT_FROM="Vavito Archives <notifications@contact.vavitoarchives.com.br>"
MAIL_NEWSLETTER_FROM="Vavito Archives <newsletter@newsletter.vavitoarchives.com.br>"
MAIL_ADMIN_RECIPIENT=replace_with_admin_email
MAIL_REPLY_TO=replace_with_monitored_reply_email

# Compartilhado entre servidores; use um valor aleatório em ambientes reais
NEWSLETTER_TOKEN_SECRET=replace_with_a_32_character_newsletter_secret
REVALIDATION_SECRET=replace_with_at_least_32_random_characters
VIEW_FINGERPRINT_SECRET=replace_with_another_32_character_random_secret
